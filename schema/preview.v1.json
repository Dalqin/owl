{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preview",
  "description": "What a front end shows while someone is setting a mod up: the manifest as\nit would be written, what the installer would do, and what the mod needs.",
  "type": "object",
  "properties": {
    "changed": {
      "description": "Whether the manifest differs from the one it was previewed from. Always\ntrue for a new mod; for a stored mod it tells whether the answers changed anything.",
      "type": "boolean"
    },
    "fomod": {
      "description": "Present when the mod has a FOMOD installer and it drove the decisions.",
      "anyOf": [
        {
          "$ref": "#/$defs/Resolution"
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "description": "Manual choices that do not match the scan.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/DecisionIssue"
      }
    },
    "manifest": {
      "$ref": "#/$defs/Manifest"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Requirement"
      }
    },
    "unanswered": {
      "description": "Installer questions the player still has to answer. The mod should not be\nadded or saved while any are open.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    }
  },
  "required": [
    "manifest",
    "issues",
    "requirements",
    "unanswered",
    "changed"
  ],
  "$defs": {
    "Choice": {
      "description": "One thing the player picked: an option inside a group, optionally pinned to\na step when group names repeat. Names compare case-insensitively.",
      "type": "object",
      "properties": {
        "group": {
          "type": "string"
        },
        "option": {
          "type": "string"
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "group",
        "option"
      ]
    },
    "Condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            },
            "kind": {
              "type": "string",
              "const": "and"
            }
          },
          "required": [
            "kind",
            "all"
          ]
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            },
            "kind": {
              "type": "string",
              "const": "or"
            }
          },
          "required": [
            "kind",
            "any"
          ]
        },
        {
          "type": "object",
          "properties": {
            "flag": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "flag"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "flag",
            "value"
          ]
        },
        {
          "description": "A condition we do not evaluate (plugin present, game version, ...).",
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "unsupported"
            }
          },
          "required": [
            "kind",
            "description"
          ]
        }
      ]
    },
    "ConditionalInstall": {
      "type": "object",
      "properties": {
        "condition": {
          "$ref": "#/$defs/Condition"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileInstall"
          }
        }
      },
      "required": [
        "condition",
        "files"
      ]
    },
    "DatapathCandidate": {
      "description": "A folder that could be passed to OpenMW as a `data=` path.",
      "type": "object",
      "properties": {
        "engine_dirs": {
          "description": "Engine directories found directly inside (original casing).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "description": "Path relative to the scanned root; empty means the root itself.",
          "type": "string"
        },
        "plugins": {
          "description": "Plugin files found directly inside.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginInfo"
          }
        }
      },
      "required": [
        "path",
        "engine_dirs",
        "plugins"
      ]
    },
    "DecisionIssue": {
      "oneOf": [
        {
          "description": "A chosen data path is no longer among the scanned candidates.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "datapath_missing"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ]
        },
        {
          "description": "An enabled plugin is not present in any chosen data path.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plugin_missing"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        }
      ]
    },
    "Decisions": {
      "description": "Choices made by a human or a curated source. Never touched by a rescan.",
      "type": "object",
      "properties": {
        "datapaths": {
          "description": "Chosen data paths, relative to the mod root, in the order they should\nappear in `openmw.cfg` (later entries override earlier ones).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enabled_plugins": {
          "description": "Plugin file names to enable, in load order within this mod.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fomod_choices": {
          "description": "What was picked in the FOMOD installer. When non-empty, `datapaths` and\n`enabled_plugins` were derived from these by [`Manifest::choose_fomod`].",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Choice"
          }
        },
        "load_after": {
          "description": "Names of plugins this mod should load after, when masters don't say so.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "datapaths",
        "enabled_plugins",
        "load_after"
      ]
    },
    "Derived": {
      "description": "Facts computed by the scanner. Regenerable.",
      "type": "object",
      "properties": {
        "datapath_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DatapathCandidate"
          }
        },
        "fomod": {
          "description": "The mod's FOMOD installer, if it ships one.",
          "anyOf": [
            {
              "$ref": "#/$defs/FomodInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "description": "What the author left for the people installing the mod.",
          "$ref": "#/$defs/ModNotes",
          "default": {
            "documents": [],
            "info": null
          }
        }
      },
      "required": [
        "datapath_candidates"
      ]
    },
    "DocumentKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "text",
            "markdown",
            "html"
          ]
        },
        {
          "description": "An internet shortcut; `text` is its address.",
          "type": "string",
          "const": "link"
        },
        {
          "description": "Something the author left that is not shown as text (PDF, Word, RTF).",
          "type": "string",
          "const": "other"
        }
      ]
    },
    "FileInstall": {
      "type": "object",
      "properties": {
        "destination": {
          "description": "Relative to the data folder, with `/` separators. Empty means the root.",
          "type": "string"
        },
        "is_folder": {
          "type": "boolean"
        },
        "priority": {
          "description": "Higher priority overrides lower where files collide.",
          "type": "integer",
          "format": "int32"
        },
        "source": {
          "description": "Relative to [`FomodInfo::base`], with `/` separators.",
          "type": "string"
        }
      },
      "required": [
        "source",
        "destination",
        "is_folder",
        "priority"
      ]
    },
    "FlagSetting": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "FomodInfo": {
      "type": "object",
      "properties": {
        "base": {
          "description": "Folder the installer's relative paths start from (the parent of its\n`fomod/` folder), relative to the scanned root. Empty for the root.",
          "type": "string"
        },
        "conditional_installs": {
          "description": "Installed when their condition holds after all steps.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConditionalInstall"
          }
        },
        "module_image": {
          "description": "The installer's banner picture, relative to the scanned root.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "module_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_files": {
          "description": "Installed regardless of choices.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileInstall"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        }
      },
      "required": [
        "base",
        "required_files",
        "steps",
        "conditional_installs"
      ]
    },
    "FomodOption": {
      "type": "object",
      "properties": {
        "default_type": {
          "description": "Type when no pattern matches.",
          "$ref": "#/$defs/OptionType"
        },
        "description": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileInstall"
          }
        },
        "image": {
          "description": "The option's picture, relative to the scanned root.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "name": {
          "type": "string"
        },
        "sets_flags": {
          "description": "Flags set when this option is selected.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FlagSetting"
          }
        },
        "type_patterns": {
          "description": "Flag-dependent overrides, first match wins.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypePattern"
          }
        }
      },
      "required": [
        "name",
        "description",
        "default_type",
        "type_patterns",
        "sets_flags",
        "files"
      ]
    },
    "FomodProblem": {
      "oneOf": [
        {
          "description": "A choice does not match any option in a visible step, or is not allowed.",
          "type": "object",
          "properties": {
            "choice": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "invalid_choice"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "choice",
            "reason"
          ]
        },
        {
          "description": "The player still has to decide, or decided something inconsistent.",
          "type": "object",
          "properties": {
            "cause": {
              "$ref": "#/$defs/Unresolved"
            },
            "group": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "group_unresolved"
            },
            "reason": {
              "description": "In words, for showing as it is.",
              "type": "string"
            },
            "step": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "step",
            "group",
            "cause",
            "reason"
          ]
        },
        {
          "description": "A condition we cannot evaluate was treated as false.",
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "unsupported_condition"
            }
          },
          "required": [
            "kind",
            "description"
          ]
        },
        {
          "description": "An install cannot be expressed as an OpenMW data path.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "not_representable"
            },
            "reason": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source",
            "reason"
          ]
        },
        {
          "description": "An install points at something the scan did not find.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "source_not_found"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source"
          ]
        }
      ]
    },
    "Group": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/GroupKind"
        },
        "name": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FomodOption"
          }
        }
      },
      "required": [
        "name",
        "kind",
        "options"
      ]
    },
    "GroupKind": {
      "type": "string",
      "enum": [
        "select_all",
        "select_any",
        "select_exactly_one",
        "select_at_least_one",
        "select_at_most_one"
      ]
    },
    "InfoField": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "Manifest": {
      "type": "object",
      "properties": {
        "decisions": {
          "$ref": "#/$defs/Decisions"
        },
        "derived": {
          "$ref": "#/$defs/Derived"
        },
        "name": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "name",
        "derived",
        "decisions"
      ]
    },
    "ModInfo": {
      "description": "The installer's `fomod/info.xml`, all of it.",
      "type": "object",
      "properties": {
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "description": "The author's full description, as written.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "other": {
          "description": "Any other field the file has, so nothing the author wrote is dropped.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/InfoField"
          }
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "website": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "other"
      ]
    },
    "ModNotes": {
      "type": "object",
      "properties": {
        "documents": {
          "description": "Readme-like files, nearest the top of the folder first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NoteDocument"
          }
        },
        "info": {
          "description": "From the installer's `info.xml`, if the mod has one.",
          "anyOf": [
            {
              "$ref": "#/$defs/ModInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "documents"
      ]
    },
    "NoteDocument": {
      "type": "object",
      "properties": {
        "error": {
          "description": "Why the file could not be read, if it could not.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/DocumentKind"
        },
        "path": {
          "description": "Relative to the scanned folder.",
          "type": "string"
        },
        "text": {
          "description": "The text, for kinds that have any. HTML is turned into plain text.",
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "description": "The file was longer than what is kept in `text`.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "kind",
        "truncated"
      ]
    },
    "OptionType": {
      "type": "string",
      "enum": [
        "required",
        "recommended",
        "optional",
        "could_be_usable",
        "not_usable"
      ]
    },
    "PluginInfo": {
      "type": "object",
      "properties": {
        "error": {
          "description": "Set when the header could not be parsed. The plugin is still listed.",
          "type": [
            "string",
            "null"
          ]
        },
        "masters": {
          "description": "Masters from the plugin header; empty if none or if it could not be read.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "masters"
      ]
    },
    "Question": {
      "description": "One installer question, named the way the installer names it.",
      "type": "object",
      "properties": {
        "group": {
          "type": "string"
        },
        "step": {
          "type": "string"
        }
      },
      "required": [
        "step",
        "group"
      ]
    },
    "Requirement": {
      "description": "One line of \"A mod needs these things\".",
      "type": "object",
      "properties": {
        "needed_by": {
          "description": "Enabled plugins that need it.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/RequirementStatus"
        }
      },
      "oneOf": [
        {
          "description": "A master plugin the mod's plugins depend on.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "master"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        }
      ],
      "required": [
        "status",
        "needed_by"
      ]
    },
    "RequirementStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "satisfied",
            "missing"
          ]
        },
        {
          "description": "The environment could not say (e.g. installed plugins not known).",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "Resolution": {
      "description": "What a set of choices amounts to.",
      "type": "object",
      "properties": {
        "datapaths": {
          "description": "Data paths relative to the scan root, in order (later overrides earlier).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FomodProblem"
          }
        },
        "selected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectedOption"
          }
        },
        "visible_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "visible_steps",
        "selected",
        "flags",
        "datapaths",
        "plugins",
        "problems"
      ]
    },
    "SelectedOption": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string"
        },
        "option": {
          "type": "string"
        },
        "step": {
          "type": "string"
        }
      },
      "required": [
        "step",
        "group",
        "option"
      ]
    },
    "Source": {
      "description": "Where the mod came from, so it can be re-fetched and verified.",
      "type": "object",
      "properties": {
        "archive_sha256": {
          "description": "Lowercase hex SHA-256 of the downloaded archive.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "Step": {
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Group"
          }
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "description": "Step is shown only when this holds. `None` means always.",
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "groups"
      ]
    },
    "TypePattern": {
      "type": "object",
      "properties": {
        "condition": {
          "$ref": "#/$defs/Condition"
        },
        "kind": {
          "$ref": "#/$defs/OptionType"
        }
      },
      "required": [
        "condition",
        "kind"
      ]
    },
    "Unresolved": {
      "description": "Why a group of options is not settled.",
      "oneOf": [
        {
          "description": "Nothing is chosen and the installer gives no default: the player must answer.",
          "type": "string",
          "const": "choice_needed"
        },
        {
          "description": "More options are chosen than the group allows.",
          "type": "string",
          "const": "too_many_chosen"
        }
      ]
    }
  }
}
